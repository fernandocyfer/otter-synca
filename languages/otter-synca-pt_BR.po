#: admin/partials/otter-synca-admin-help.php:39
msgid "1. Create a GitHub Token"
msgstr "1. Crie um Token do GitHub"

#: admin/partials/otter-synca-admin-help.php:40
msgid "To get started, you need to create a personal access token on GitHub:"
msgstr "Para começar, você precisa criar um token de acesso pessoal no GitHub:"

#: admin/partials/otter-synca-admin-help.php:42
msgid "Go to GitHub settings"
msgstr "Acesse as configurações do GitHub"

#: admin/partials/otter-synca-admin-help.php:43
msgid ""
"Navigate to \"Developer settings\" > \"Personal access tokens\" > \"Tokens "
"(classic)\""
msgstr ""
"Acesse \"Developer settings\" > \"Personal access tokens\" > \"Tokens "
"(classic)\""

#: admin/partials/otter-synca-admin-help.php:44
msgid "Click \"Generate new token\""
msgstr "Clique em \"Generate new token\""

#: admin/partials/otter-synca-admin-help.php:45
msgid "Give the token a name and select \"repo\" permissions"
msgstr "Dê um nome ao token e selecione as permissões \"repo\""

#: admin/partials/otter-synca-admin-help.php:46
msgid ""
"Copy the generated token and paste it in the \"GitHub Token\" field in the "
"plugin settings"
msgstr ""
"Copie o token gerado e cole no campo \"GitHub Token\" nas configurações do "
"plugin"

#: admin/partials/otter-synca-admin-help.php:52
msgid "2. Configure the Plugin"
msgstr "2. Configure o Plugin"

#: admin/partials/otter-synca-admin-help.php:53
msgid ""
"After creating the token, configure the plugin with the following "
"information:"
msgstr "Após criar o token, configure o plugin com as seguintes informações:"

#: admin/partials/otter-synca-admin-help.php:55
msgid "Repository: Repository name in the format username/repository"
msgstr "Repositório: Nome do repositório no formato username/repository"

#: admin/partials/otter-synca-admin-help.php:56
msgid "Branch: Branch you want to deploy (default: main)"
msgstr "Branch: Branch que você deseja fazer deploy (padrão: main)"

#: admin/partials/otter-synca-admin-help.php:57
msgid "Deploy Type: Select whether it is a plugin or theme"
msgstr "Tipo de Deploy: Selecione se é um plugin ou tema"

#: admin/partials/otter-synca-admin-help.php:58
msgid "Target Slug: Name of the plugin or theme that will be updated"
msgstr "Slug do Alvo: Nome do plugin ou tema que será atualizado"

#: admin/partials/otter-synca-admin-help.php:64
msgid "3. Deploy"
msgstr "3. Faça o Deploy"

#: admin/partials/otter-synca-admin-help.php:65
msgid "With everything configured, you can deploy:"
msgstr "Com tudo configurado, você pode fazer o deploy:"

#: admin/partials/otter-synca-admin-help.php:67
msgid "Verify that all settings are correct"
msgstr "Verifique se todas as configurações estão corretas"

#: admin/partials/otter-synca-admin-help.php:68
msgid "Click the \"Deploy Now\" button"
msgstr "Clique no botão \"Fazer Deploy Agora\""

#: admin/partials/otter-synca-admin-help.php:69
msgid "Wait for the process to complete"
msgstr "Aguarde o processo ser concluído"

#: admin/partials/otter-synca-admin-help.php:70
msgid "Check the deploy status in the sidebar"
msgstr "Verifique o status do deploy na barra lateral"

#: admin/partials/otter-synca-admin-help.php:79
msgid "Common questions"
msgstr "Dúvidas comuns"

