msgid "Webhook Secret"
msgstr "Webhook Secret"

#: admin/partials/otter-synca-admin-settings.php:179
msgid "Click \"Generate Secret\" or type manually"
msgstr "Clique em 'Gerar Secret' ou digite manualmente"

#: admin/partials/otter-synca-admin-settings.php:182
msgid "Generate Secret"
msgstr "Gerar Secret"

#: admin/partials/otter-synca-admin-settings.php:186
msgid ""
"GitHub webhook secret. Use the \"Generate Secret\" button to create a secure "
"key automatically."
msgstr ""
"Secret do webhook do GitHub. Use o botão \"Gerar Secret\" para criar uma "
"chave segura automaticamente."

#: admin/partials/otter-synca-admin-settings.php:193
msgid "Webhook URL"
msgstr "URL do Webhook"

#: admin/partials/otter-synca-admin-settings.php:202
msgid ""
"Configure this URL in your GitHub repository as a webhook to enable "
"automatic deployment."
msgstr ""
"Configure esta URL no seu repositório GitHub como webhook para ativar o "
"deploy automático."

#: admin/partials/otter-synca-admin-settings.php:205
msgid "How to configure:"
msgstr "Como configurar:"

#: admin/partials/otter-synca-admin-settings.php:206
msgid "Go to Settings > Webhooks in your GitHub repository"
msgstr "Vá para Settings > Webhooks no seu repositório GitHub"

#: admin/partials/otter-synca-admin-settings.php:207
#: admin/partials/otter-synca-admin-settings.php:211
msgid "Click \"Add webhook\""
msgstr "Clique em \"Add webhook\""

#: admin/partials/otter-synca-admin-settings.php:208
msgid "Paste the URL above in the \"Payload URL\" field"
msgstr "Cole a URL acima no campo \"Payload URL\""

#: admin/partials/otter-synca-admin-settings.php:209
msgid "Select \"Just the push event\""
msgstr "Selecione \"Just the push event\""

#: admin/partials/otter-synca-admin-settings.php:210
msgid "Add the required secret shown above"
msgstr "Adicione o secret obrigatório exibido acima"

#: admin/partials/otter-synca-admin-settings.php:218
msgid "Save Settings"
msgstr "Salvar Configurações"

