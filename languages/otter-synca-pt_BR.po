#. Plugin Name of the plugin
#: otter-synca.php
msgid "OtterSynca – Git Deployment & Sync Tool"
msgstr "OtterSynca – Ferramenta de Deploy e Sincronização Git"

#. Plugin URI of the plugin
#: otter-synca.php
msgid "https://ottersynca.com"
msgstr "https://ottersynca.com"

#. Description of the plugin
#: otter-synca.php
msgid ""
"Deploy WordPress plugins and themes directly from GitHub repositories. "
"Automatize your workflow with automatic deploys, multiple repositories, "
"backups, and detailed logs. Get <a href=\"https://plugins.cyfer.com.br/"
"downloads/ottersynca-deploy-para-wordpress/\" target=\"_blank\">OtterSynca "
"Pro</a> for advanced features."
msgstr ""
"Implante plugins e temas do WordPress diretamente de repositórios GitHub. "
"Automatize seu fluxo de trabalho com deploys automáticos, múltiplos "
"repositórios, backups e logs detalhados. Adquira o <a href=\"https://"
"plugins.cyfer.com.br/downloads/ottersynca-deploy-para-wordpress/\" "
"target=\"_blank\">OtterSynca Pro</a> para ter recursos avançados."

