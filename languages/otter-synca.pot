#: admin/partials/otter-synca-admin-help.php:25
msgid "1. Crie um Token do GitHub"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:26
msgid "Para começar, você precisa criar um token de acesso pessoal no GitHub:"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:28
msgid "Acesse as configurações do GitHub"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:29
msgid "Vá para \"Developer settings\" > \"Personal access tokens\""
msgstr ""

#: admin/partials/otter-synca-admin-help.php:30
msgid "Clique em \"Generate new token\""
msgstr ""

#: admin/partials/otter-synca-admin-help.php:31
msgid "Dê um nome ao token e selecione as permissões \"repo\""
msgstr ""

#: admin/partials/otter-synca-admin-help.php:32
msgid "Copie o token gerado e cole no campo \"GitHub Token\" nas configurações do plugin"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:37
msgid "2. Configure o Plugin"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:38
msgid "Após criar o token, configure o plugin com as seguintes informações:"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:40
msgid "Repositório: Nome do repositório no formato username/repository"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:41
msgid "Branch: Branch que você deseja fazer deploy (padrão: main)"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:42
msgid "Tipo de Deploy: Selecione se é um plugin ou tema"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:43
msgid "Slug do Alvo: Nome do plugin ou tema que será atualizado"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:48
msgid "3. Faça o Deploy"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:49
msgid "Com tudo configurado, você pode fazer o deploy:"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:51
msgid "Verifique se todas as configurações estão corretas"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:52
msgid "Clique no botão \"Fazer Deploy Agora\""
msgstr ""

#: admin/partials/otter-synca-admin-help.php:53
msgid "Aguarde o processo ser concluído"
msgstr ""

#: admin/partials/otter-synca-admin-help.php:54
